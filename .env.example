# Required for answers, translations, contradiction checks, and evaluation.
GROQ_API_KEY=replace_with_your_groq_api_key

# Set APP_ENV=production and provide a long, unique key before exposing the app.
APP_ENV=development
APP_API_KEY=

# Model and runtime controls.
GROQ_MODEL=openai/gpt-oss-20b
DEEPEVAL_GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=1
GROQ_MAX_COMPLETION_TOKENS=512
LIVE_EVALUATION_ENABLED=true
RAG_EVAL_REPORT_PATH=../rag-evaluations/rag_evaluation_report.xlsx
TOP_K=4
RETRIEVAL_FETCH_K=16
MAX_RETRIEVAL_DISTANCE=1.0
MAX_CONTEXT_CHARS=6000
MAX_QUESTION_CHARS=2000
